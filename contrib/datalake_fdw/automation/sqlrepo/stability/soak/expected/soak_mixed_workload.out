-- end_ignore
-- Cleanup the helper
DROP FUNCTION soak_run_batch(INT);
DROP TABLE public.soak_batch_cursor;
-- Final VACUUM
VACUUM soak_tbl;
-- Deterministic output only: regression boolean. iteration_count intentionally
-- omitted so pg_regress diff holds across CI/Nightly profiles (which use
-- different STABILITY_SOAK_ITERATIONS). Users who want the count can query
-- public.soak_iter_stats directly after the run.
WITH this_run AS (
    SELECT s.iter_idx, s.iter_duration_ms,
           ntile(4) OVER (ORDER BY s.iter_idx) AS q
    FROM public.soak_iter_stats s, _soak_run r
    WHERE s.run_ts = r.run_ts
),
quartiles AS (
    SELECT q, AVG(iter_duration_ms) AS avg_ms FROM this_run GROUP BY q
)
SELECT
    CASE
        WHEN (SELECT count(*) FROM this_run) = 0 THEN false
        WHEN (SELECT avg_ms FROM quartiles WHERE q=1) = 0 THEN true
        -- 10x threshold is calibrated for a table that grows through the
        -- run - smaller threshold triggers on normal scan cost growth,
        -- not leaks. A true memory/FD leak typically shows 50x+ drift.
        WHEN (SELECT avg_ms FROM quartiles WHERE q=4) /
             (SELECT avg_ms FROM quartiles WHERE q=1) < 10.0 THEN true
        ELSE false
    END AS no_severe_regression;
 no_severe_regression 
----------------------
 t
(1 row)

-- Cleanup
DROP TABLE soak_tbl;
DROP VOLUME soak_vol;
DROP USER MAPPING FOR current_user SERVER soak_vol_srv;
DROP SERVER soak_vol_srv;
DROP CATALOG soak_cat;
DROP USER MAPPING FOR current_user SERVER soak_cat_srv;
DROP SERVER soak_cat_srv;
