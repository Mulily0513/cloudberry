-- ============================================================
DROP FOREIGN TABLE IF EXISTS hudi_mor_multi_delta;
DROP FOREIGN TABLE IF EXISTS hudi_mor_bulk;
DROP FOREIGN TABLE IF EXISTS hudi_cow_types;
DROP FOREIGN TABLE IF EXISTS hudi_mor_part_delta;
