-- 01_joins.sql
-- Test JOIN operations across Hive tables
\i ../../../lib/sql/common_setup.sql
-- common_setup.sql
-- Base setup for all datalake_fdw tests
-- This file should be included at the beginning of all test SQL files
-- Create required extensions
CREATE EXTENSION IF NOT EXISTS datalake_fdw;
CREATE EXTENSION IF NOT EXISTS hive_connector;
-- gp_exttable_delimiter may not be available in all environments.
-- Silence the "already exists, skipping" NOTICE emitted in CI where the
-- extension has been created by an earlier test or initdb step.
SET client_min_messages = WARNING;
DO $$ BEGIN
    CREATE EXTENSION IF NOT EXISTS gp_exttable_delimiter;
EXCEPTION WHEN OTHERS THEN
    -- Extension not available, skip silently
END $$;
RESET client_min_messages;
-- Create foreign data wrapper if not already present
-- Note: CREATE FOREIGN DATA WRAPPER does not support IF NOT EXISTS syntax
DO $$ BEGIN
    IF NOT EXISTS (SELECT 1 FROM pg_foreign_data_wrapper WHERE fdwname = 'datalake_fdw') THEN
        EXECUTE 'CREATE FOREIGN DATA WRAPPER datalake_fdw
            HANDLER datalake_fdw_handler
            VALIDATOR datalake_fdw_validator
            OPTIONS (mpp_execute ''all segments'')';
    END IF;
END $$;
-- Set standard date style for consistent output
SET datestyle = ISO, MDY;
-- Create logging utility function
CREATE OR REPLACE FUNCTION test_log(message text)
RETURNS void AS $$
BEGIN
    RAISE NOTICE '[TEST] %', message;
END;
$$ LANGUAGE plpgsql;
-- Log setup completion
SELECT test_log('Common setup completed');
NOTICE:  [TEST] Common setup completed
 test_log 
----------
 
(1 row)

\i ../../../lib/sql/hive_server_setup.sql
-- hive_server_setup.sql
-- Hive server configuration for datalake_fdw tests
-- Requires: common_setup.sql to be loaded first
--
-- This file creates the hive_server foreign server using the public.create_foreign_server() function
-- Default configuration uses Docker service names from docker-compose.yml
-- Create server and user mapping for hive
-- Parameters: server_name, user, wrapper, cluster_name
-- The public.create_foreign_server() function handles all necessary setup
SELECT public.create_foreign_server('hive_server', 'gpadmin', 'datalake_fdw', 'paa_cluster');
 create_foreign_server 
-----------------------
 t
(1 row)

-- Log server creation
SELECT test_log('Hive server setup completed');
NOTICE:  [TEST] Hive server setup completed
 test_log 
----------
 
(1 row)

-- Create test schema
DROP SCHEMA IF EXISTS feature_test CASCADE;
NOTICE:  schema "feature_test" does not exist, skipping
CREATE SCHEMA feature_test;
SELECT test_log('Feature Test: JOIN Operations');
NOTICE:  [TEST] Feature Test: JOIN Operations
 test_log 
----------
 
(1 row)

-- Setup: Sync two tables for joining
SELECT test_log('Setup: Sync test tables');
NOTICE:  [TEST] Setup: Sync test tables
 test_log 
----------
 
(1 row)

SELECT public.sync_hive_table('hive_cluster','default','test_orc','paa_cluster', 'feature_test.table_a', 'hive_server');
 sync_hive_table 
-----------------
 t
(1 row)

SELECT public.sync_hive_table('hive_cluster','default','test_parquet','paa_cluster', 'feature_test.table_b', 'hive_server');
 sync_hive_table 
-----------------
 t
(1 row)

-- Test 1: INNER JOIN
SELECT test_log('Test 1: INNER JOIN');
NOTICE:  [TEST] Test 1: INNER JOIN
 test_log 
----------
 
(1 row)

SELECT COUNT(*) as inner_join_count
FROM feature_test.table_a a
INNER JOIN feature_test.table_b b ON a.id = b.id;
 inner_join_count 
------------------
                1
(1 row)

-- Test 2: LEFT JOIN
SELECT test_log('Test 2: LEFT JOIN');
NOTICE:  [TEST] Test 2: LEFT JOIN
 test_log 
----------
 
(1 row)

SELECT COUNT(*) as left_join_count,
       COUNT(b.id) as matched_count
FROM feature_test.table_a a
LEFT JOIN feature_test.table_b b ON a.id = b.id;
 left_join_count | matched_count 
-----------------+---------------
               2 |             1
(1 row)

-- Test 3: Multiple JOIN conditions
SELECT test_log('Test 3: Multiple JOIN conditions');
NOTICE:  [TEST] Test 3: Multiple JOIN conditions
 test_log 
----------
 
(1 row)

SELECT COUNT(*) as multi_condition_join
FROM feature_test.table_a a
INNER JOIN feature_test.table_b b
    ON a.id = b.id AND a.name = b.name;
 multi_condition_join 
----------------------
                    1
(1 row)

-- Test 4: Self JOIN
SELECT test_log('Test 4: Self JOIN');
NOTICE:  [TEST] Test 4: Self JOIN
 test_log 
----------
 
(1 row)

SELECT COUNT(*) as self_join_count
FROM feature_test.table_a a1
INNER JOIN feature_test.table_a a2
    ON a1.id < a2.id;
 self_join_count 
-----------------
               0
(1 row)

-- Cleanup
DROP SCHEMA feature_test CASCADE;
NOTICE:  drop cascades to 2 other objects
DETAIL:  drop cascades to foreign table feature_test.table_a
drop cascades to foreign table feature_test.table_b
