set vector.hashjoin_spill_memory_mb = 0;
select count(*) as cnt, sum(length(b.col_pad)) as chk from spill_build b join spill_probe p on b.col_int8 = p.col_int8;
  cnt  |   chk   
-------+---------
 50000 | 7500000
(1 row)

set vector.hashjoin_spill_memory_mb = 1;
select count(*) as cnt, sum(length(b.col_pad)) as chk from spill_build b join spill_probe p on b.col_int8 = p.col_int8;
  cnt  |   chk   
-------+---------
 50000 | 7500000
(1 row)

