set vector.hashjoin_spill_memory_mb = 0;
select sum(b.col_numeric) as s, avg(b.col_float4) as a, sum(length(b.col_pad)) as chk from spill_probe p left join spill_build b on b.id = p.id;
       s       |         a          |   chk   
---------------+--------------------+---------
