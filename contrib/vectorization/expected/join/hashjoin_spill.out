(1 row)

set vector.hashjoin_spill_memory_mb = 1;
select count(*) as cnt, sum(length(b.col_pad)) as chk from spill_build b where not exists (select 1 from spill_probe p where p.id = b.id);
  cnt  |   chk   
-------+---------
