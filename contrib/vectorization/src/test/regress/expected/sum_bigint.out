-- Regression test for F_SUM_INT8 / sum(bigint) in vectorized two-stage
-- aggregation. Before the fix, F_SUM_INT8 was wired to avg_trans/sum_final
-- (struct<sum:int64,count:int64>) but GP's coordinator-side combine expects
-- struct<sum:numeric128,count:int64>. The type mismatch caused SEGFAULT on
-- queries using sum(bigint) with redistribute, e.g. TPC-DS Q14.
--
-- Fix: planner_vec.agg_trans_mutator routes F_SUM_INT8 to NUMERICOID and
-- fmgr.c's arrow_agg_fmgr_builtins maps F_SUM_INT8 to the direct sum_64 path
-- (no avg_trans middle stage).
--
-- Coverage targets:
--   contrib/vectorization/src/backend/optimizer/planner_vec.c (F_SUM_INT8 case)
--   contrib/vectorization/src/backend/utils/arrow/fmgr.c       (sum_64 entry)
set vector.enable_vectorization = on;
drop table if exists sum_int8_t;
NOTICE:  table "sum_int8_t" does not exist, skipping
create table sum_int8_t (
    grp int,
    v_int8  bigint,
    v_int4  int,
    v_int2  smallint,
    v_num   numeric(20,2)
) distributed by (grp);
-- 50K rows across 100 groups. Per-row v_int8 is set so per-group sum exceeds
-- INT32_MAX (forcing numeric output to be meaningful). Cast i to bigint
-- before multiplying so the literal does not overflow int4.
insert into sum_int8_t
select
    i % 100,
    (i::bigint * 1000000),
    i,
    (i % 32767)::smallint,
    (i * 1.5)::numeric(20,2)
from generate_series(1, 50000) i;
analyze sum_int8_t;
-- Two-stage aggregation: GROUP BY on the distribution key still goes through
-- agg_trans_mutator's INITIAL_SERIAL path because vectorization wraps it in
-- partial+final. Verifies both per-group sum and grand sum.
select count(*) as g,
       sum(s_int8) as total_sum_int8,
       sum(s_int4) as total_sum_int4,
       sum(s_int2) as total_sum_int2,
       sum(s_num)  as total_sum_num
from (
    select grp,
           sum(v_int8) as s_int8,
           sum(v_int4) as s_int4,
           sum(v_int2) as s_int2,
           sum(v_num)  as s_num
    from sum_int8_t
    group by grp
) s;
  g  |  total_sum_int8  | total_sum_int4 | total_sum_int2 | total_sum_num 
-----+------------------+----------------+----------------+---------------
 100 | 1250025000000000 |     1250025000 |      685318522 | 1875037500.00
(1 row)

-- Two-stage aggregation triggered by Redistribute Motion: GROUP BY on a
-- non-distribution key. This is the plan shape that originally crashed
-- with SIGSEGV when F_SUM_INT8 took the avg_trans/sum_final path.
select count(*) as g,
       sum(s_int8) as total_sum_int8
from (
    select v_int4 % 7 as grp7,
           sum(v_int8) as s_int8
    from sum_int8_t
    group by v_int4 % 7
) s;
 g |  total_sum_int8  
---+------------------
 7 | 1250025000000000
(1 row)

-- Plain aggregate (no GROUP BY) on a distributed table also goes through
-- two-stage agg + Gather Motion. Result must match a purely numeric sum.
select sum(v_int8) as total,
       sum(v_int8::numeric) as total_via_numeric
from sum_int8_t;
      total       | total_via_numeric 
------------------+-------------------
 1250025000000000 |  1250025000000000
(1 row)

-- avg(bigint) follows the avg_trans/sum_final/avg_final path which the
-- arrow side fix supports (struct<sum:numeric128,count:int64>). Cover both
-- per-group and global avg to catch any regression in the typed sum_final.
select count(*) as g,
       round(avg(g_avg)::numeric, 6) as avg_of_per_group_avg
from (
    select grp, avg(v_int8) as g_avg
    from sum_int8_t
    group by grp
) s;
  g  | avg_of_per_group_avg 
-----+----------------------
 100 |   25000500000.000000
(1 row)

select round(avg(v_int8)::numeric, 6) as global_avg
from sum_int8_t;
     global_avg     
--------------------
 25000500000.000000
(1 row)

drop table sum_int8_t;
reset vector.enable_vectorization;
