   sum(b + c), max(c) - min(b)
   FROM wh_src WHERE b < 16
   GROUP BY 1, 2 HAVING sum(c) > 10)
  UNION ALL
  (SELECT time_bucket('1 hour'::interval, time), loc,
   sum(b + c), max(c) - min(b)
   FROM wh_src WHERE b < 16
   GROUP BY 1, 2 HAVING sum(c) > 10
   EXCEPT
   SELECT bucket, loc, sbc, spread FROM cv_wh
   )
) x;
