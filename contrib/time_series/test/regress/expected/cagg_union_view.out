   FROM metrics GROUP BY tags_id)
  UNION ALL
  (SELECT tags_id, count(*)::bigint
   FROM metrics GROUP BY tags_id
   EXCEPT
   SELECT tags_id, sum(cnt)::bigint AS total
   FROM cv GROUP BY tags_id
   )
) x;
