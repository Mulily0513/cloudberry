SELECT pg_get_viewdef(
    ('time_series.' ||
     (SELECT partial_view_name FROM time_series.continuous_agg
      WHERE user_view_name = 't6_distinct_agg'))::regclass
) LIKE '%DISTINCT%' AS distinct_preserved;
 distinct_preserved 
--------------------
