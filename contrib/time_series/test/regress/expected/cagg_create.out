DECLARE
  mat_name text;
BEGIN
  SELECT mat_table_schema || '.' || mat_table_name INTO mat_name
  FROM time_series.continuous_agg WHERE user_view_name = 'trunc_cv';
  EXECUTE format('TRUNCATE %s', mat_name);
END $$;
