-- parallel index scan with hash aggregation
explain (verbose, costs off) select a, count(*) from pidx1 where a < 1000 group by a;
                                   QUERY PLAN                                   
--------------------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Output: a, (count(*))
   ->  HashAggregate
         Output: a, count(*)
         Group Key: pidx1.a
         ->  Redistribute Motion 6:6  (slice2; segments: 6)
               Output: a
               Hash Key: a
               Hash Module: 3
               ->  Parallel Index Scan using pidx1_a_idx on orca_parallel.pidx1
                     Output: a
                     Index Cond: (pidx1.a < 1000)
 Settings: enable_parallel = 'on', optimizer = 'on', parallel_setup_cost = '0'
 Optimizer: GPORCA
(14 rows)

