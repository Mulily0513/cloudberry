-- Nested subquery with LIMIT - inner limit should prevent parallel index scan
explain (costs off)
select * from pidx1 where a in (
    select c from pidx2 where c in (
        select a from pidx1 limit 5
    )
);
                                                    QUERY PLAN                                                    
------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Hash Semi Join
         Hash Cond: (pidx1.a = pidx2.c)
         ->  Seq Scan on pidx1
         ->  Hash
               ->  Redistribute Motion 3:3  (slice2; segments: 3)
                     Hash Key: pidx2.c
                     ->  Nested Loop
                           Join Filter: true
                           ->  GroupAggregate
                                 Group Key: pidx1_1.a
                                 ->  Sort
                                       Sort Key: pidx1_1.a
                                       ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                             Hash Key: pidx1_1.a
                                             ->  GroupAggregate
                                                   Group Key: pidx1_1.a
                                                   ->  Sort
                                                         Sort Key: pidx1_1.a
                                                         ->  Redistribute Motion 1:3  (slice4)
                                                               ->  Limit
                                                                     ->  Gather Motion 3:1  (slice5; segments: 3)
                                                                           ->  Limit
                                                                                 ->  Seq Scan on pidx1 pidx1_1
                           ->  Index Scan using pidx2_c_idx on pidx2
                                 Index Cond: (c = pidx1_1.a)
 Optimizer: GPORCA
(27 rows)

