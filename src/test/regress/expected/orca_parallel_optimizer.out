-- parallel index scan inside IN subquery
set enable_hashagg = off;
explain (verbose, costs off) select * from pidx1 where a in (select c from pidx2 where c < 500);
                                   QUERY PLAN                                   
-------------------------------------------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Output: pidx1.a, pidx1.b
   ->  Parallel Hash Semi Join
         Output: pidx1.a, pidx1.b
         Hash Cond: (pidx1.a = pidx2.c)
         ->  Parallel Seq Scan on orca_parallel.pidx1
               Output: pidx1.a, pidx1.b
         ->  Parallel Hash
               Output: pidx2.c
               ->  Parallel Index Scan using pidx2_c_idx on orca_parallel.pidx2
                     Output: pidx2.c
                     Index Cond: (pidx2.c < 500)
 Settings: enable_hashagg = 'off', enable_parallel = 'on', optimizer = 'on', parallel_setup_cost = '0'
 Optimizer: GPORCA
(14 rows)

