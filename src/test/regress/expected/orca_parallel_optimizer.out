(1 row)

reset enable_hashagg;
-- Subquery with LIMIT and ORDER BY should NOT use parallel scan
explain (verbose, costs off) select * from pidx1 where a in (select c from pidx2 order by c limit 10);
                                          QUERY PLAN                                           
-----------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Output: pidx1.a, pidx1.b
   ->  Nested Loop
         Output: pidx1.a, pidx1.b
         Join Filter: true
         ->  Redistribute Motion 1:3  (slice2)
               Output: pidx2.c
               Hash Key: pidx2.c
               ->  GroupAggregate
                     Output: pidx2.c
                     Group Key: pidx2.c
                     ->  Limit
                           Output: pidx2.c
                           ->  Gather Motion 3:1  (slice3; segments: 3)
                                 Output: pidx2.c
                                 Merge Key: pidx2.c
                                 ->  Limit
                                       Output: pidx2.c
                                       ->  Index Scan using pidx2_c_idx on orca_parallel.pidx2
                                             Output: pidx2.c
         ->  Index Scan using pidx1_a_idx on orca_parallel.pidx1
               Output: pidx1.a, pidx1.b
               Index Cond: (pidx1.a = pidx2.c)
 Settings: enable_parallel = 'on', optimizer = 'on', parallel_setup_cost = '0'
 Optimizer: GPORCA
(25 rows)

