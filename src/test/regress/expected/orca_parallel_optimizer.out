-- Hash Agg
drop table if exists t0;
NOTICE:  table "t0" does not exist, skipping
create table t0 (
    a int,
    b int
) distributed by (b);
insert into t0
select i % 10000, i 
from generate_series(1, 5000000) i;
analyze t0;
explain (costs off) select a, count(*) from t0 group by a;
                         QUERY PLAN                         
------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   ->  Finalize HashAggregate
         Group Key: a
         ->  Redistribute Motion 6:6  (slice2; segments: 6)
               Hash Key: a
               Hash Module: 3
               ->  Streaming Partial HashAggregate
                     Group Key: a
                     ->  Parallel Seq Scan on t0
 Optimizer: GPORCA
(10 rows)

explain (costs off) select b, count(*) from t0 group by b;
                         QUERY PLAN                         
------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   ->  HashAggregate
         Group Key: b
         ->  Redistribute Motion 6:6  (slice2; segments: 6)
               Hash Key: b
               Hash Module: 3
               ->  Parallel Seq Scan on t0
 Optimizer: GPORCA
(8 rows)

-- Group Agg
set optimizer_enable_hashagg = off;
explain (costs off) select a, count(*) from t0 group by a;
                            QUERY PLAN                            
------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   ->  Finalize GroupAggregate
         Group Key: a
         ->  Sort
               Sort Key: a
               ->  Redistribute Motion 6:6  (slice2; segments: 6)
                     Hash Key: a
                     Hash Module: 3
                     ->  Partial GroupAggregate
                           Group Key: a
                           ->  Sort
                                 Sort Key: a
                                 ->  Parallel Seq Scan on t0
 Optimizer: GPORCA
(14 rows)

explain (costs off) select b, count(*) from t0 group by b;
                            QUERY PLAN                            
------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  GroupAggregate
         Group Key: b
         ->  Sort
               Sort Key: b
               ->  Redistribute Motion 6:3  (slice2; segments: 6)
                     Hash Key: b
                     ->  Parallel Seq Scan on t0
 Optimizer: GPORCA
(9 rows)

reset optimizer_enable_hashagg;
-- DQA
explain (costs off) select b, count(distinct a) from t1 group by b;
                            QUERY PLAN                            
------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  GroupAggregate
         Group Key: b
         ->  Sort
               Sort Key: b
               ->  Redistribute Motion 6:3  (slice2; segments: 6)
                     Hash Key: b
                     ->  Parallel Seq Scan on t1
 Optimizer: GPORCA
(9 rows)

-- No-Group-by Agg
explain (costs off) select count(*), sum(b) from t0;
                   QUERY PLAN                   
------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 6:1  (slice1; segments: 6)
         ->  Partial Aggregate
               ->  Parallel Seq Scan on t0
 Optimizer: GPORCA
(5 rows)

explain (costs off)
select * from t1 where a in (
    select c from t2 limit 10
);
                                              QUERY PLAN                                              
------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Hash Join
         Hash Cond: (t1.a = t2.c)
         ->  Seq Scan on t1
         ->  Hash
               ->  GroupAggregate
                     Group Key: t2.c
                     ->  Sort
                           Sort Key: t2.c
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: t2.c
                                 ->  GroupAggregate
                                       Group Key: t2.c
                                       ->  Sort
                                             Sort Key: t2.c
                                             ->  Redistribute Motion 1:3  (slice3)
                                                   ->  Limit
                                                         ->  Gather Motion 3:1  (slice4; segments: 3)
                                                               ->  Limit
                                                                     ->  Seq Scan on t2
 Optimizer: GPORCA
(21 rows)

-- Subquery with LIMIT and ORDER BY should NOT use parallel scan
explain (costs off)
select * from t1 where a in (
    select c from t2 order by c limit 10
);
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Hash Semi Join
         Hash Cond: (t1.a = t2.c)
         ->  Seq Scan on t1
         ->  Hash
               ->  Broadcast Motion 1:3  (slice2)
                     ->  Limit
                           ->  Gather Motion 3:1  (slice3; segments: 3)
                                 Merge Key: t2.c
                                 ->  Limit
                                       ->  Sort
                                             Sort Key: t2.c
                                             ->  Seq Scan on t2
 Optimizer: GPORCA
(14 rows)

-- Top-level LIMIT should still allow parallel scan (query_level = 0)
explain (costs off) select * from t2 limit 100;
                   QUERY PLAN                   
------------------------------------------------
 Limit
   ->  Gather Motion 6:1  (slice1; segments: 6)
         ->  Limit
               ->  Parallel Seq Scan on t2
 Optimizer: GPORCA
(5 rows)

-- Nested subquery with LIMIT - inner limit should prevent parallel scan
explain (costs off)
select * from t1 where a in (
    select c from t2 where d in (
        select a from t1 limit 5
    )
);
                                                       QUERY PLAN                                                       
------------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Hash Semi Join
         Hash Cond: (t1.a = t2.c)
         ->  Seq Scan on t1
         ->  Hash
               ->  Hash Join
                     Hash Cond: (t2.d = t1_1.a)
                     ->  Seq Scan on t2
                     ->  Hash
                           ->  Broadcast Motion 3:3  (slice2; segments: 3)
                                 ->  GroupAggregate
                                       Group Key: t1_1.a
                                       ->  Sort
                                             Sort Key: t1_1.a
                                             ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                                   Hash Key: t1_1.a
                                                   ->  GroupAggregate
                                                         Group Key: t1_1.a
                                                         ->  Sort
                                                               Sort Key: t1_1.a
                                                               ->  Redistribute Motion 1:3  (slice4)
                                                                     ->  Limit
                                                                           ->  Gather Motion 3:1  (slice5; segments: 3)
                                                                                 ->  Limit
                                                                                       ->  Seq Scan on t1 t1_1
 Optimizer: GPORCA
(26 rows)

-- parallel index scan test
create table pidx1(a int, b int) with (parallel_workers=2) distributed by (a);
create table pidx2(c int, d int) with (parallel_workers=2) distributed by (c);
create table pidx3(e int, f int) with (parallel_workers=2) distributed by (e);
create index pidx1_a_idx on pidx1(a);
create index pidx1_b_idx on pidx1(b);
create index pidx2_c_idx on pidx2(c);
create index pidx2_d_idx on pidx2(d);
create index pidx3_e_idx on pidx3(e);
create index pidx3_f_idx on pidx3(f);
insert into pidx1 select i, i from generate_series(1, 10000) i;
insert into pidx2 select i, i from generate_series(1, 200000) i;
insert into pidx3 select i, i from generate_series(1, 300) i;
analyze pidx1;
analyze pidx2;
analyze pidx3;
-- parallel index scan(simple)
explain (verbose, costs off) select * from pidx1 where a < 1000;
                                  QUERY PLAN                                   
-------------------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Output: a, b
   ->  Parallel Index Scan using pidx1_a_idx on orca_parallel.pidx1
         Output: a, b
         Index Cond: (pidx1.a < 1000)
 Settings: enable_parallel = 'on', optimizer = 'on', parallel_setup_cost = '0'
 Optimizer: GPORCA
(7 rows)

select count(*) from pidx1 where a < 1000;
 count 
-------
   999
(1 row)

explain (verbose, costs off) select * from pidx1 where b < 1000;
                                  QUERY PLAN                                   
-------------------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Output: a, b
   ->  Parallel Index Scan using pidx1_b_idx on orca_parallel.pidx1
         Output: a, b
         Index Cond: (pidx1.b < 1000)
 Settings: enable_parallel = 'on', optimizer = 'on', parallel_setup_cost = '0'
 Optimizer: GPORCA
(7 rows)

select count(*) from pidx1 where b < 1000;
 count 
-------
   999
(1 row)

-- parallel index scan(no redistribute motion)
explain (verbose, costs off) select * from pidx1 left join pidx2 on pidx1.a = pidx2.c where pidx1.a < 1000;
                                   QUERY PLAN                                   
--------------------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Output: pidx1.a, pidx1.b, pidx2.c, pidx2.d
   ->  Parallel Hash Left Join
         Output: pidx1.a, pidx1.b, pidx2.c, pidx2.d
         Hash Cond: (pidx1.a = pidx2.c)
         ->  Parallel Index Scan using pidx1_a_idx on orca_parallel.pidx1
               Output: pidx1.a, pidx1.b
               Index Cond: (pidx1.a < 1000)
         ->  Parallel Hash
               Output: pidx2.c, pidx2.d
               ->  Parallel Index Scan using pidx2_c_idx on orca_parallel.pidx2
                     Output: pidx2.c, pidx2.d
                     Index Cond: (pidx2.c < 1000)
 Settings: enable_parallel = 'on', optimizer = 'on', parallel_setup_cost = '0'
 Optimizer: GPORCA
(15 rows)

