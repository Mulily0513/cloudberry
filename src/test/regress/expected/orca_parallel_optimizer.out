 Settings: enable_parallel = 'on', optimizer = 'on', parallel_setup_cost = '0'
 Optimizer: GPORCA
(13 rows)

-- Semi Join
explain (verbose, costs off) select *  from t1 where exists (select 1 from t2 where t2.c = t1.a);
                         QUERY PLAN                          
-------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Output: t1.a, t1.b
   ->  Parallel Hash Semi Join
         Output: t1.a, t1.b
         Hash Cond: (t1.a = t2.c)
         ->  Parallel Seq Scan on orca_parallel.t1
               Output: t1.a, t1.b
               Filter: (NOT (t1.a IS NULL))
         ->  Parallel Hash
               Output: (1), t2.c
               ->  Parallel Seq Scan on orca_parallel.t2
                     Output: 1, t2.c
 Settings: enable_parallel = 'on', parallel_setup_cost = '0'
 Optimizer: GPORCA
(14 rows)

create table t3_null(c2 int) distributed randomly;
insert into t3_null values (1), (2), (3), (null), (5), (null), (10), (20);
analyze t3_null;
-- Anti Semi Join (not-in)
explain (costs off) select * from t1 where a not in (select c2 from t3_null);
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   ->  Parallel Hash Left Anti Semi (Not-In) Join
         Hash Cond: (t1.a = t3_null.c2)
         ->  Parallel Seq Scan on t1
         ->  Parallel Hash
               ->  Broadcast Workers Motion 6:6  (slice2; segments: 6)
                     ->  Parallel Seq Scan on t3_null
 Optimizer: GPORCA
(8 rows)

-- Broadcast Motion
drop table if exists t1;
drop table if exists t2;
create table t1(a int, b int) with(parallel_workers=2) distributed by (a);
create table t2(c int, d int ) with(parallel_workers=2) distributed by (c);
insert into t1 select i, i+1 from generate_series(1, 100)i;
insert into t2 select i, i+2 from generate_series(1, 30000)i;
analyze t1;
analyze t2;
explain (verbose, costs off) select * from t1  join t2  on t1.a = t2.c;
                         QUERY PLAN                          
-------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Output: t1.a, t1.b, t2.c, t2.d
   ->  Parallel Hash Join
         Output: t1.a, t1.b, t2.c, t2.d
         Hash Cond: (t2.c = t1.a)
         ->  Parallel Seq Scan on orca_parallel.t2
               Output: t2.c, t2.d
         ->  Parallel Hash
               Output: t1.a, t1.b
               ->  Parallel Seq Scan on orca_parallel.t1
                     Output: t1.a, t1.b
 Settings: enable_parallel = 'on', parallel_setup_cost = '0'
 Optimizer: GPORCA
(13 rows)

explain (verbose, costs off) select * from t1  join t2  on t1.a = t2.d;
                              QUERY PLAN                               
-----------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Output: t1.a, t1.b, t2.c, t2.d
   ->  Parallel Hash Join
         Output: t1.a, t1.b, t2.c, t2.d
         Hash Cond: (t2.d = t1.a)
         ->  Parallel Seq Scan on orca_parallel.t2
               Output: t2.c, t2.d
         ->  Parallel Hash
               Output: t1.a, t1.b
               ->  Broadcast Workers Motion 6:6  (slice2; segments: 6)
                     Output: t1.a, t1.b
                     ->  Parallel Seq Scan on orca_parallel.t1
                           Output: t1.a, t1.b
 Settings: enable_parallel = 'on', parallel_setup_cost = '0'
 Optimizer: GPORCA
(15 rows)

explain (verbose, costs off) select * from t1  join t2  on t1.b = t2.c;
                            QUERY PLAN                            
------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Output: t1.a, t1.b, t2.c, t2.d
   ->  Parallel Hash Join
         Output: t1.a, t1.b, t2.c, t2.d
         Hash Cond: (t2.c = t1.b)
         ->  Parallel Seq Scan on orca_parallel.t2
               Output: t2.c, t2.d
         ->  Parallel Hash
               Output: t1.a, t1.b
               ->  Redistribute Motion 6:6  (slice2; segments: 6)
                     Output: t1.a, t1.b
                     Hash Key: t1.b
                     Hash Module: 3
                     ->  Parallel Seq Scan on orca_parallel.t1
                           Output: t1.a, t1.b
 Settings: enable_parallel = 'on', parallel_setup_cost = '0'
 Optimizer: GPORCA
(17 rows)

