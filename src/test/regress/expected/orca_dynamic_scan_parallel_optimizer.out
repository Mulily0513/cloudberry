-- =============================================================
-- Create a second partitioned table for join tests
-- =============================================================
CREATE TABLE pdss_other (a int, b int, c text) PARTITION BY RANGE (a);
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column named 'a' as the Apache Cloudberry data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
CREATE TABLE pdss_other_1 PARTITION OF pdss_other FOR VALUES FROM (1) TO (400);
NOTICE:  table has parent, setting distribution columns to match parent table
CREATE TABLE pdss_other_2 PARTITION OF pdss_other FOR VALUES FROM (400) TO (800);
NOTICE:  table has parent, setting distribution columns to match parent table
ALTER TABLE pdss_other_1 SET (parallel_workers = 2);
ALTER TABLE pdss_other_2 SET (parallel_workers = 2);
INSERT INTO pdss_other SELECT i, i * 3, 'other_' || i FROM generate_series(1, 799) i;
ANALYZE pdss_other;
-- =============================================================
-- Left outer join with partitioned tables
-- =============================================================
EXPLAIN (COSTS OFF)
SELECT count(*)
FROM pdss_part p LEFT JOIN pdss_other o ON p.a = o.a AND o.b > 1500
WHERE p.a BETWEEN 1 AND 300;
                                    QUERY PLAN                                    
----------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 6:1  (slice1; segments: 6)
         ->  Partial Aggregate
               ->  Parallel Hash Left Join
                     Hash Cond: (p.a = o.a)
                     ->  Parallel Dynamic Seq Scan on pdss_part p
                           Number of partitions to scan: 4 (out of 8)
                           Filter: ((a >= 1) AND (a <= 300))
                     ->  Parallel Hash
                           ->  Parallel Dynamic Seq Scan on pdss_other o
                                 Number of partitions to scan: 1 (out of 2)
                                 Filter: ((b > 1500) AND (a >= 1) AND (a <= 300))
 Optimizer: GPORCA
(13 rows)

SELECT count(*)
FROM pdss_part p LEFT JOIN pdss_other o ON p.a = o.a AND o.b > 1500
WHERE p.a BETWEEN 1 AND 300;
 count 
-------
   300
(1 row)

-- =============================================================
-- Anti-join (NOT EXISTS) with parallel scan
-- Workaround: disable parallel append to avoid incorrect DPE
-- pruning on the outer side of anti-joins (known bug).
-- =============================================================
SET optimizer_enable_parallel_append = off;
EXPLAIN (COSTS OFF)
SELECT count(*)
FROM pdss_part p
WHERE NOT EXISTS (SELECT 1 FROM pdss_other o WHERE o.a = p.a AND o.b > 2000);
                            QUERY PLAN
------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 6:1  (slice1; segments: 6)
         ->  Partial Aggregate
               ->  Parallel Hash Anti Join
                     Hash Cond: (p.a = o.a)
                     ->  Parallel Dynamic Seq Scan on pdss_part p
                           Number of partitions to scan: 8 (out of 8)
                     ->  Parallel Hash
                           ->  Parallel Dynamic Seq Scan on pdss_other o
                                 Number of partitions to scan: 2 (out of 2)
                                 Filter: (b > 2000)
 Optimizer: GPORCA
(12 rows)

SELECT count(*)
FROM pdss_part p
WHERE NOT EXISTS (SELECT 1 FROM pdss_other o WHERE o.a = p.a AND o.b > 2000);
 count 
-------
   666
(1 row)

RESET optimizer_enable_parallel_append;
-- =============================================================
-- Semi-join (EXISTS) with parallel scan
-- =============================================================
EXPLAIN (COSTS OFF)
SELECT count(*)
FROM pdss_part p
WHERE EXISTS (SELECT 1 FROM pdss_other o WHERE o.a = p.a AND o.b < 500);
                                                QUERY PLAN                                                
----------------------------------------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather Motion 6:1  (slice1; segments: 6)
         ->  Partial Aggregate
               ->  Result
                     Filter: (COALESCE((count(*)), '0'::bigint) > '0'::bigint)
                     ->  Parallel Hash Left Join
                           Hash Cond: (p.a = o.a)
                           ->  Parallel Dynamic Seq Scan on pdss_part p
                                 Number of partitions to scan: 8 (out of 8)
                                 Filter: (NOT (a IS NULL))
                           ->  Parallel Hash
                                 ->  Result
                                       ->  Redistribute Motion 6:6  (slice2; segments: 6)
                                             Hash Key: o.a
                                             Hash Module: 3
                                             ->  HashAggregate
                                                   Group Key: o.a
                                                   ->  Redistribute Motion 6:6  (slice3; segments: 6)
                                                         Hash Key: o.a
                                                         Hash Module: 3
                                                         ->  Parallel Dynamic Seq Scan on pdss_other o
                                                               Number of partitions to scan: 2 (out of 2)
                                                               Filter: (b < 500)
 Optimizer: GPORCA
(24 rows)

SELECT count(*)
FROM pdss_part p
WHERE EXISTS (SELECT 1 FROM pdss_other o WHERE o.a = p.a AND o.b < 500);
 count 
-------
   166
(1 row)

-- =============================================================
-- Window functions over parallel scan
-- =============================================================
EXPLAIN (COSTS OFF)
SELECT a, b, row_number() OVER (ORDER BY a) AS rn
FROM pdss_part
WHERE a BETWEEN 1 AND 10
ORDER BY a;
                           QUERY PLAN                           
----------------------------------------------------------------
 WindowAgg
   Order By: a
   ->  Gather Motion 6:1  (slice1; segments: 6)
         Merge Key: a
         ->  Sort
               Sort Key: a
               ->  Parallel Dynamic Seq Scan on pdss_part
                     Number of partitions to scan: 1 (out of 8)
                     Filter: ((a >= 1) AND (a <= 10))
 Optimizer: GPORCA
(10 rows)

SELECT a, b, row_number() OVER (ORDER BY a) AS rn
FROM pdss_part
WHERE a BETWEEN 1 AND 10
ORDER BY a;
 a  | b  | rn 
----+----+----
  1 |  2 |  1
  2 |  4 |  2
  3 |  6 |  3
  4 |  8 |  4
  5 | 10 |  5
  6 | 12 |  6
  7 | 14 |  7
  8 | 16 |  8
  9 | 18 |  9
 10 | 20 | 10
(10 rows)

EXPLAIN (COSTS OFF)
SELECT a, sum(b) OVER (PARTITION BY a / 100) AS partition_sum
FROM pdss_part
WHERE a BETWEEN 1 AND 20
ORDER BY a;
                                    QUERY PLAN                                    
----------------------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Merge Key: a
   ->  Result
         ->  Sort
               Sort Key: a
               ->  Parallel WindowAgg
                     Partition By: ((a / 100))
                     ->  Sort
                           Sort Key: ((a / 100))
                           ->  Redistribute Motion 6:6  (slice2; segments: 6)
                                 Hash Key: ((a / 100))
                                 Hash Module: 3
                                 ->  Parallel Dynamic Seq Scan on pdss_part
                                       Number of partitions to scan: 1 (out of 8)
                                       Filter: ((a >= 1) AND (a <= 20))
 Optimizer: GPORCA
(16 rows)

SELECT a, sum(b) OVER (PARTITION BY a / 100) AS partition_sum
FROM pdss_part
