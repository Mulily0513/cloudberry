-- =============================================================
-- DISTINCT with parallel scan
-- =============================================================
EXPLAIN (COSTS OFF)
SELECT DISTINCT c FROM pdss_part WHERE a BETWEEN 1 AND 5 ORDER BY c;
                              QUERY PLAN                              
----------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Merge Key: c
   ->  GroupAggregate
         Group Key: c
         ->  Sort
               Sort Key: c
               ->  Redistribute Motion 6:6  (slice2; segments: 6)
                     Hash Key: c
                     Hash Module: 3
                     ->  Parallel Dynamic Seq Scan on pdss_part
                           Number of partitions to scan: 1 (out of 8)
                           Filter: ((a >= 1) AND (a <= 5))
 Optimizer: GPORCA
(13 rows)

SELECT DISTINCT c FROM pdss_part WHERE a BETWEEN 1 AND 5 ORDER BY c;
   c   
-------
 row_1
 row_2
 row_3
 row_4
 row_5
(5 rows)

-- =============================================================
-- GROUP BY + HAVING with parallel scan
-- =============================================================
EXPLAIN (COSTS OFF)
SELECT a / 100 AS bucket, count(*), sum(b)
FROM pdss_part
GROUP BY a / 100
HAVING count(*) > 50
ORDER BY bucket;
                                 QUERY PLAN                                 
----------------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Merge Key: ((a / 100))
   ->  Sort
         Sort Key: ((a / 100))
         ->  Result
               Filter: ((count(*)) > 50)
               ->  HashAggregate
                     Group Key: ((a / 100))
                     ->  Redistribute Motion 6:6  (slice2; segments: 6)
                           Hash Key: ((a / 100))
                           Hash Module: 3
                           ->  Parallel Dynamic Seq Scan on pdss_part
                                 Number of partitions to scan: 8 (out of 8)
 Optimizer: GPORCA
(14 rows)

SELECT a / 100 AS bucket, count(*), sum(b)
FROM pdss_part
GROUP BY a / 100
HAVING count(*) > 50
ORDER BY bucket;
 bucket | count |  sum   
--------+-------+--------
      0 |    99 |   9900
      1 |   100 |  29900
      2 |   100 |  49900
      3 |   100 |  69900
      4 |   100 |  89900
      5 |   100 | 109900
      6 |   100 | 129900
      7 |   100 | 149900
(8 rows)

-- =============================================================
-- CTE with parallel scan
-- =============================================================
EXPLAIN (COSTS OFF)
WITH part_stats AS (
    SELECT a / 100 AS bucket, count(*) AS cnt, sum(b) AS total
    FROM pdss_part
    GROUP BY a / 100
)
SELECT bucket, cnt, total
FROM part_stats
WHERE cnt > 50
ORDER BY bucket;
                                 QUERY PLAN                                 
----------------------------------------------------------------------------
 Gather Motion 6:1  (slice1; segments: 6)
   Merge Key: ((a / 100))
   ->  Sort
         Sort Key: ((a / 100))
         ->  Result
               Filter: ((count(*)) > 50)
               ->  HashAggregate
                     Group Key: ((a / 100))
                     ->  Redistribute Motion 6:6  (slice2; segments: 6)
                           Hash Key: ((a / 100))
                           Hash Module: 3
                           ->  Parallel Dynamic Seq Scan on pdss_part
                                 Number of partitions to scan: 8 (out of 8)
 Optimizer: GPORCA
(14 rows)

WITH part_stats AS (
    SELECT a / 100 AS bucket, count(*) AS cnt, sum(b) AS total
    FROM pdss_part
    GROUP BY a / 100
)
SELECT bucket, cnt, total
FROM part_stats
WHERE cnt > 50
ORDER BY bucket;
 bucket | cnt | total  
