-- Nested subquery with LIMIT - inner limit should prevent parallel index only scan
explain (costs off)
select a, b from pios1 where a in (
    select d from pios2 where d in (
        select a from pios1 limit 5
    )
);
                                                    QUERY PLAN                                                    
------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Hash Semi Join
         Hash Cond: (pios1.a = pios2.d)
         ->  Seq Scan on pios1
         ->  Hash
               ->  Redistribute Motion 3:3  (slice2; segments: 3)
                     Hash Key: pios2.d
                     ->  Nested Loop
                           Join Filter: true
                           ->  GroupAggregate
                                 Group Key: pios1_1.a
                                 ->  Sort
                                       Sort Key: pios1_1.a
                                       ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                             Hash Key: pios1_1.a
                                             ->  GroupAggregate
                                                   Group Key: pios1_1.a
                                                   ->  Sort
                                                         Sort Key: pios1_1.a
                                                         ->  Redistribute Motion 1:3  (slice4)
                                                               ->  Limit
                                                                     ->  Gather Motion 3:1  (slice5; segments: 3)
                                                                           ->  Limit
                                                                                 ->  Seq Scan on pios1 pios1_1
                           ->  Index Only Scan using pios2_de_idx on pios2
                                 Index Cond: (d = pios1_1.a)
 Optimizer: GPORCA
(27 rows)

